# Source-availability exception for exhaustive all-config builds.
#
# CONFIG_TOUCHSCREEN_MTK_SOLOMON is requested in all-configs-requested.txt,
# but MediaTek's Kconfig points at a SOLOMON/ directory that is absent from
# the published MT6853 and related Android 4.14 GPL source releases. Keeping
# it=y makes scripts/Makefile.modbuiltin fail before any C source is compiled.
# This is retained as an explicit, auditable exception until real GPL source
# is located; no empty Makefile or fake driver stub is substituted.
# CONFIG_TOUCHSCREEN_MTK_SOLOMON is not set

# CONFIG_TOUCHSCREEN_MTK_GSLX680 requests gslX680/$(MTK_PLATFORM), but
# the MT6853 implementation is absent from indexed MediaTek Android GPL trees.
# Other-platform gslX680 code is not substituted because it is not the A32x driver.
# CONFIG_TOUCHSCREEN_MTK_GSLX680 is not set

# CONFIG_MTK_PMIC_CHIP_MT6355 references an accdet/mt6355 subtree that is
# absent from indexed MediaTek GPL releases. The A32x uses a different PMIC;
# no unrelated PMIC implementation is substituted.
# CONFIG_MTK_PMIC_CHIP_MT6355 is not set
