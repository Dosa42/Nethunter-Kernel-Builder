# Source-availability exception for exhaustive all-config builds.
#
# CONFIG_TOUCHSCREEN_MTK_SOLOMON is requested in all-configs-requested.txt,
# but MediaTek's Kconfig points at a SOLOMON/ directory that is absent from
# the published MT6853 and related Android 4.14 GPL source releases. Keeping
# it=y makes scripts/Makefile.modbuiltin fail before any C source is compiled.
# This is retained as an explicit, auditable exception until real GPL source
# is located; no empty Makefile or fake driver stub is substituted.
# CONFIG_TOUCHSCREEN_MTK_SOLOMON is not set

# CONFIG_TOUCHSCREEN_MTK_GSLX680 requests gslX680/$(MTK_PLATFORM), but
# the MT6853 implementation is absent from indexed MediaTek Android GPL trees.
# Other-platform gslX680 code is not substituted because it is not the A32x driver.
# CONFIG_TOUCHSCREEN_MTK_GSLX680 is not set

# CONFIG_MTK_PMIC_CHIP_MT6355 references an accdet/mt6355 subtree that is
# absent from indexed MediaTek GPL releases. The A32x uses a different PMIC;
# no unrelated PMIC implementation is substituted.
# CONFIG_MTK_PMIC_CHIP_MT6355 is not set

# Native A32x platform identity.
#
# The exhaustive request enabled mutually incompatible MediaTek machine,
# audio-machine, and PMIC selections together. A native A32x kernel is MT6853
# with the MT6359 family. Foreign SoC machine targets cannot be linked into
# the same hardware kernel and also select unpublished per-platform paths.
CONFIG_MACH_MT6853=y
# CONFIG_MACH_MT6739 is not set
# CONFIG_MACH_MT6765 is not set
# CONFIG_MACH_MT6768 is not set
# CONFIG_MACH_MT6771 is not set
# CONFIG_MACH_MT6785 is not set
# CONFIG_MACH_MT6833 is not set
# CONFIG_MACH_MT6873 is not set
# CONFIG_MACH_MT6885 is not set
# CONFIG_MACH_MT6893 is not set
# CONFIG_MACH_MT8167 is not set
# CONFIG_MACH_MT8168 is not set

# CONFIG_SND_SOC_MT2701 is not set
# CONFIG_SND_SOC_MT2701_CS42448 is not set
# CONFIG_SND_SOC_MT2701_WM8960 is not set
# CONFIG_SND_SOC_MT6768 is not set
# CONFIG_SND_SOC_MT6768_MT6358 is not set
# CONFIG_SND_SOC_MT6785 is not set
# CONFIG_SND_SOC_MT6785_MT6359 is not set
CONFIG_SND_SOC_MT6853=y
CONFIG_SND_SOC_MT6853_MT6359=y
# CONFIG_SND_SOC_MT6873 is not set
# CONFIG_SND_SOC_MT6873_MT6359 is not set
# CONFIG_SND_SOC_MT6885 is not set
# CONFIG_SND_SOC_MT6885_MT6359 is not set
# CONFIG_SND_SOC_MT6893 is not set
# CONFIG_SND_SOC_MT6893_MT6359 is not set
# CONFIG_SND_SOC_MT8167 is not set
# CONFIG_SND_SOC_MT8167_CODEC is not set
# CONFIG_SND_SOC_MT8167_MT6392_MACH is not set
# CONFIG_SND_SOC_MT8168 is not set
# CONFIG_SND_SOC_MT8168_EVB is not set
# CONFIG_SND_SOC_MT8168_FPGA is not set
# CONFIG_SND_SOC_MT8168_P1 is not set
# CONFIG_SND_SOC_MT8173 is not set
# CONFIG_SND_SOC_MT8173_MAX98090 is not set
# CONFIG_SND_SOC_MT8173_RT5650 is not set
# CONFIG_SND_SOC_MT8173_RT5650_RT5514 is not set
# CONFIG_SND_SOC_MT8173_RT5650_RT5676 is not set

# CONFIG_MTK_PMIC_CHIP_MT6335 is not set
# CONFIG_MTK_PMIC_CHIP_MT6353 is not set
# CONFIG_MTK_PMIC_CHIP_MT6356 is not set
# CONFIG_MTK_PMIC_CHIP_MT6357 is not set
# CONFIG_MTK_PMIC_CHIP_MT6358 is not set
CONFIG_MTK_PMIC_CHIP_MT6359=y
CONFIG_MTK_PMIC_CHIP_MT6359P=y
# CONFIG_MTK_PMIC_CHIP_MT6390 is not set
# CONFIG_SND_SOC_MT6358 is not set
# SND_SOC_ALL_CODECS is only a bulk selector; leaving it on overrides the
# explicit MT6358 platform exception. Every compatible codec remains requested
# individually by the generated 3,258-symbol fragment.
# CONFIG_SND_SOC_ALL_CODECS is not set
# CONFIG_SND_SOC_MT6392_CODEC is not set

# Native MT6853 optional wrappers with unpublished platform implementations.
# CONFIG_SND_SOC_MTK_SCP_SMARTPA is not set
# CONFIG_MTK_LASTBUS_INTERFACE is not set

# Native MT6853 EMI wrapper has no published platform implementation.
# CONFIG_MTK_EMI is not set

# FIVE_GKI_* redirects task integrity into android_vendor_data1 storage used
# by GKI task_struct. This Samsung Linux 4.14 tree is non-GKI and instead
# provides task_struct.integrity, so keep FIVE enabled in its native mode.
CONFIG_FIVE=y
# CONFIG_FIVE_GKI_10 is not set
# CONFIG_FIVE_GKI_20 is not set

# Native MT6853 EMI MPU wrapper has no published platform implementation.
# CONFIG_MTK_EMI_MPU is not set

# The native A32x DDK is CONFIG_MTK_GPU_VERSION="mali valhall r25p0".
# MTK_GPU_R5P0 is a legacy override that bypasses that DDK selector and
# incorrectly requests the unpublished drivers/misc/mediatek/gpu/mt6853 path.
CONFIG_MTK_GPU_SUPPORT=y
CONFIG_MTK_GPU_VERSION="mali valhall r25p0"
# CONFIG_MTK_GPU_R5P0 is not set

# CONFIG_MTK_HIFIXDSP_SUPPORT selects hifi_dsp/$(CONFIG_MTK_PLATFORM),
# but no MT6853 implementation is published in the Samsung, Xiaomi, Oppo,
# Realme, or Motorola MT6853 GPL trees checked. No empty DSP stub is supplied.
# CONFIG_MTK_HIFIXDSP_SUPPORT is not set

# Samsung A32x uses the published SMCDSD_PANEL_A32X path. The legacy generic
# MTK_LCM wrapper is disabled in Samsung's native defconfig; all-config enabling
# it expands a stale two-panel string and requests an unpublished ili9882n tree.
# CONFIG_MTK_LCM is not set
# CONFIG_MTK_LCM_DEVICE_TREE_SUPPORT is not set
CONFIG_SMCDSD_PANEL=y
CONFIG_SMCDSD_PANEL_A32X=y

# Low-power platform modules are mutually exclusive SoC implementations.
# Keep the native MT6853 module and prevent foreign all-config selections from
# requesting unpublished/non-A32x debug subtrees.
# CONFIG_MTK_LPM_MT6779 is not set
# CONFIG_MTK_LPM_MT6833 is not set
CONFIG_MTK_LPM_MT6853=y
# CONFIG_MTK_LPM_MT6873 is not set
# CONFIG_MTK_LPM_MT6885 is not set

# Samsung A32x disables the legacy MTK_M4U wrapper and uses pseudo-M4U plus
# MTK IOMMU v2. All-config enabling MTK_M4U requests an unpublished mt6853
# directory. Preserve the native memory-IOMMU stack.
# CONFIG_MTK_M4U is not set
CONFIG_MTK_PSEUDO_M4U=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_MTK_IOMMU_V2=y

# Samsung A32x disables the legacy MU3 PHY stack and uses the published MTK USB
# PHY plus XHCI host driver. PROJECT_PHY otherwise requests mu3phy/mt6853.
# CONFIG_MU3_PHY is not set
# CONFIG_PROJECT_PHY is not set
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_XHCI_MTK_SUSPEND=y
CONFIG_USB_PHY=y
CONFIG_PHY_MTK_USB=y

# A32x uses the maintained MTK_PMIC_WRAP core with MT6359P. The legacy HAL
# wrapper is disabled in Samsung's defconfig and requests pmic_wrap/mt6853.
# CONFIG_MTK_PMIC_WRAP_HAL is not set
CONFIG_MTK_PMIC_WRAP=y
# CONFIG_MTK_PMIC_CHIP_MT6359 is not set
CONFIG_MTK_PMIC_CHIP_MT6359P=y
CONFIG_REGULATOR_MT6359P=y

# A32x uses the 8250 MT6577 serial path; the legacy MTK_SERIAL wrapper is not
# selected by Samsung and unconditionally requests uart/mt6853.
# CONFIG_MTK_SERIAL is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_DMA_MTK_UART=y

# USB2JTAG is an LK-coupled factory debug mode that disables the normal USB
# driver while active. Samsung disables it and publishes no mt6853 backend.
# CONFIG_MTK_USB2JTAG_SUPPORT is not set

# A32x disables the legacy misc MTK_VIDEOCODEC_DRIVER and uses the published
# V4L2 MediaTek codec driver. Preserve native video encode/decode support.
# CONFIG_MTK_VIDEOCODEC_DRIVER is not set
CONFIG_MEDIA_SUPPORT=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEO_MEDIATEK_VCODEC=y

# CUSTOM_BATTERY_EXTERNAL_CHANNEL is an internal MT6885 alpha-board gauge test,
# not an A32x battery feature. Keep the native Samsung/MT6360 charger stack.
# CONFIG_CUSTOM_BATTERY_EXTERNAL_CHANNEL is not set
CONFIG_POWER_SUPPLY=y
CONFIG_MTK_CHARGER=y
CONFIG_MT6360_PMU_CHARGER=y
CONFIG_BATTERY_SAMSUNG=y
CONFIG_AFC_CHARGER=y
CONFIG_DISCRETE_CHARGER=y

# Keep Samsung PROCA enabled in its native non-GKI storage mode. PROCA_GKI_10
# redirects file signatures to android_vendor_data1, absent from this 4.14 ABI.
CONFIG_PROCA=y
# CONFIG_PROCA_GKI_10 is not set

# EXOFS remains enabled; its GCC-only VLA-in-struct allocator is patched by
# patch_allconfig_source_compat.py to equivalent Clang-compatible heap sizing.
CONFIG_EXOFS_FS=y
