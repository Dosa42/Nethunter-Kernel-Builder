# Source-availability exception for exhaustive all-config builds.
#
# CONFIG_TOUCHSCREEN_MTK_SOLOMON is requested in all-configs-requested.txt,
# but MediaTek's Kconfig points at a SOLOMON/ directory that is absent from
# the published MT6853 and related Android 4.14 GPL source releases. Keeping
# it=y makes scripts/Makefile.modbuiltin fail before any C source is compiled.
# This is retained as an explicit, auditable exception until real GPL source
# is located; no empty Makefile or fake driver stub is substituted.
# CONFIG_TOUCHSCREEN_MTK_SOLOMON is not set

# CONFIG_TOUCHSCREEN_MTK_GSLX680 requests gslX680/$(MTK_PLATFORM), but
# the MT6853 implementation is absent from indexed MediaTek Android GPL trees.
# Other-platform gslX680 code is not substituted because it is not the A32x driver.
# CONFIG_TOUCHSCREEN_MTK_GSLX680 is not set

# CONFIG_MTK_PMIC_CHIP_MT6355 references an accdet/mt6355 subtree that is
# absent from indexed MediaTek GPL releases. The A32x uses a different PMIC;
# no unrelated PMIC implementation is substituted.
# CONFIG_MTK_PMIC_CHIP_MT6355 is not set

# Native A32x platform identity.
#
# The exhaustive request enabled mutually incompatible MediaTek machine,
# audio-machine, and PMIC selections together. A native A32x kernel is MT6853
# with the MT6359 family. Foreign SoC machine targets cannot be linked into
# the same hardware kernel and also select unpublished per-platform paths.
CONFIG_MACH_MT6853=y
# CONFIG_MACH_MT6739 is not set
# CONFIG_MACH_MT6765 is not set
# CONFIG_MACH_MT6768 is not set
# CONFIG_MACH_MT6771 is not set
# CONFIG_MACH_MT6785 is not set
# CONFIG_MACH_MT6833 is not set
# CONFIG_MACH_MT6873 is not set
# CONFIG_MACH_MT6885 is not set
# CONFIG_MACH_MT6893 is not set
# CONFIG_MACH_MT8167 is not set
# CONFIG_MACH_MT8168 is not set

# CONFIG_SND_SOC_MT2701 is not set
# CONFIG_SND_SOC_MT2701_CS42448 is not set
# CONFIG_SND_SOC_MT2701_WM8960 is not set
# CONFIG_SND_SOC_MT6768 is not set
# CONFIG_SND_SOC_MT6768_MT6358 is not set
# CONFIG_SND_SOC_MT6785 is not set
# CONFIG_SND_SOC_MT6785_MT6359 is not set
CONFIG_SND_SOC_MT6853=y
CONFIG_SND_SOC_MT6853_MT6359=y
# CONFIG_SND_SOC_MT6873 is not set
# CONFIG_SND_SOC_MT6873_MT6359 is not set
# CONFIG_SND_SOC_MT6885 is not set
# CONFIG_SND_SOC_MT6885_MT6359 is not set
# CONFIG_SND_SOC_MT6893 is not set
# CONFIG_SND_SOC_MT6893_MT6359 is not set
# CONFIG_SND_SOC_MT8167 is not set
# CONFIG_SND_SOC_MT8167_CODEC is not set
# CONFIG_SND_SOC_MT8167_MT6392_MACH is not set
# CONFIG_SND_SOC_MT8168 is not set
# CONFIG_SND_SOC_MT8168_EVB is not set
# CONFIG_SND_SOC_MT8168_FPGA is not set
# CONFIG_SND_SOC_MT8168_P1 is not set
# CONFIG_SND_SOC_MT8173 is not set
# CONFIG_SND_SOC_MT8173_MAX98090 is not set
# CONFIG_SND_SOC_MT8173_RT5650 is not set
# CONFIG_SND_SOC_MT8173_RT5650_RT5514 is not set
# CONFIG_SND_SOC_MT8173_RT5650_RT5676 is not set

# CONFIG_MTK_PMIC_CHIP_MT6335 is not set
# CONFIG_MTK_PMIC_CHIP_MT6353 is not set
# CONFIG_MTK_PMIC_CHIP_MT6356 is not set
# CONFIG_MTK_PMIC_CHIP_MT6357 is not set
# CONFIG_MTK_PMIC_CHIP_MT6358 is not set
CONFIG_MTK_PMIC_CHIP_MT6359=y
CONFIG_MTK_PMIC_CHIP_MT6359P=y
# CONFIG_MTK_PMIC_CHIP_MT6390 is not set
# CONFIG_SND_SOC_MT6358 is not set
# CONFIG_SND_SOC_MT6392_CODEC is not set

# Native MT6853 optional wrappers with unpublished platform implementations.
# CONFIG_SND_SOC_MTK_SCP_SMARTPA is not set
# CONFIG_MTK_LASTBUS_INTERFACE is not set

# Native MT6853 EMI wrapper has no published platform implementation.
# CONFIG_MTK_EMI is not set

# FIVE_GKI_* redirects task integrity into android_vendor_data1 storage used
# by GKI task_struct. This Samsung Linux 4.14 tree is non-GKI and instead
# provides task_struct.integrity, so keep FIVE enabled in its native mode.
CONFIG_FIVE=y
# CONFIG_FIVE_GKI_10 is not set
# CONFIG_FIVE_GKI_20 is not set

# Native MT6853 EMI MPU wrapper has no published platform implementation.
# CONFIG_MTK_EMI_MPU is not set
